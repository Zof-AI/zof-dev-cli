{
  "name": "@zof-ai/cli",
  "version": "0.1.1",
  "description": "Local static change verification, evidence and policy command-line tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "zof": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zof-AI/zof-dev-cli.git"
  },
  "homepage": "https://github.com/Zof-AI/zof-dev-cli#readme",
  "bugs": {
    "url": "https://github.com/Zof-AI/zof-dev-cli/issues"
  },
  "keywords": [
    "verification",
    "testing",
    "zof"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.11"
  },
  "dependencies": {
    "@zof-ai/evidence-spec": "0.1.0",
    "@zof-ai/change-impact": "0.1.1",
    "@zof-ai/policy-as-code": "0.1.0",
    "@zof-ai/api-contract-check": "0.1.0",
    "@zof-ai/schema-diff": "0.1.0",
    "@zof-ai/code-risk-score": "0.1.1",
    "@zof-ai/test-selection": "0.1.1",
    "@zof-ai/testgen": "0.1.0",
    "@zof-ai/ci-evidence": "0.1.0"
  }
}
