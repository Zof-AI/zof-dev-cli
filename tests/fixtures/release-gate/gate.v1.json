{
  "components": {
    "schemas": {
      "Basis": {
        "enum": [
          "decision",
          "baseline",
          "break_glass"
        ],
        "type": "string"
      },
      "Environment": {
        "enum": [
          "production",
          "staging"
        ],
        "title": "Environment",
        "type": "string"
      },
      "FailureCode": {
        "enum": [
          "denied",
          "not_waitable",
          "evidence_timeout",
          "approval_timeout",
          "decision_timeout",
          "change_closed",
          "repo_inactive",
          "stale_decision",
          "action_expired",
          "action_already_used",
          "authorization_invalid",
          "gate_expired"
        ],
        "title": "FailureCode",
        "type": "string"
      },
      "GateError": {
        "additionalProperties": false,
        "description": "Every gate refusal: the console `{code, detail}` shape, never a 500 or a stack trace.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/GateErrorCode"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "title": "GateError",
        "type": "object"
      },
      "GateErrorCode": {
        "enum": [
          "unauthorized",
          "token_expired",
          "insufficient_scope",
          "gate_not_enabled",
          "company_unbound",
          "environment_not_allowed",
          "break_glass_not_allowed",
          "repo_not_found",
          "not_found",
          "commit_unknown",
          "commit_ambiguous",
          "idempotency_conflict",
          "payload_too_large",
          "idempotency_key_required",
          "invalid_body",
          "unknown_environment",
          "rate_limited",
          "unavailable",
          "policy_lagging",
          "verification_unavailable"
        ],
        "title": "GateErrorCode",
        "type": "string"
      },
      "GateFailure": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "$ref": "#/components/schemas/FailureCode"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "GateFailure",
        "type": "object"
      },
      "GatePipeline": {
        "additionalProperties": false,
        "properties": {
          "job": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[\\x21-\\x7e]+$",
            "title": "Job",
            "type": "string"
          },
          "provider": {
            "$ref": "#/components/schemas/Provider"
          },
          "run_attempt": {
            "minimum": 1,
            "title": "Run Attempt",
            "type": "integer"
          },
          "run_id": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[\\x21-\\x7e]+$",
            "title": "Run Id",
            "type": "string"
          },
          "run_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "pattern": "^https://[\\x21-\\x7e]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Run Url"
          }
        },
        "required": [
          "provider",
          "run_id",
          "run_attempt",
          "job"
        ],
        "title": "GatePipeline",
        "type": "object"
      },
      "GateReason": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "remedy": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RemedyAction"
              },
              {
                "type": "null"
              }
            ]
          },
          "requirement_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirement Key"
          }
        },
        "required": [
          "code",
          "requirement_key",
          "message",
          "remedy"
        ],
        "title": "GateReason",
        "type": "object"
      },
      "GateResult": {
        "enum": [
          "waiting",
          "pass",
          "fail"
        ],
        "type": "string"
      },
      "GateState": {
        "enum": [
          "waiting",
          "final"
        ],
        "type": "string"
      },
      "Provider": {
        "enum": [
          "github_actions",
          "gitlab_ci",
          "bitbucket",
          "azure_pipelines",
          "jenkins",
          "circleci",
          "other"
        ],
        "title": "Provider",
        "type": "string"
      },
      "ReleaseGateAnswer": {
        "additionalProperties": false,
        "properties": {
          "answered_at": {
            "format": "date-time",
            "title": "Answered At",
            "type": "string"
          },
          "approve_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approve Url"
          },
          "authorization_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Authorization Id"
          },
          "basis": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Basis"
              },
              {
                "type": "null"
              }
            ],
            "description": "Exit 0 only when state is `final` and result is `pass`. A pass has a basis: `decision` (a stored ALLOW with an executed authorization), `baseline` or `break_glass` (each an audited row). A recorded pass reads `fail gate_expired` 15 minutes after `answered_at` or at `wait_until`."
          },
          "change_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Change Id"
          },
          "commit_sha": {
            "title": "Commit Sha",
            "type": "string"
          },
          "console_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Console Url"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "decision_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision Id"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "failure": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GateFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "gate_id": {
            "pattern": "^gate_[0-9a-f]{32}$",
            "title": "Gate Id",
            "type": "string"
          },
          "inputs_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inputs Hash"
          },
          "kind": {
            "const": "gate_check",
            "title": "Kind",
            "type": "string"
          },
          "policy_environment": {
            "$ref": "#/components/schemas/Environment"
          },
          "poll_after_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poll After Seconds"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/GateReason"
            },
            "maxItems": 20,
            "title": "Reasons",
            "type": "array"
          },
          "reasons_total": {
            "minimum": 0,
            "title": "Reasons Total",
            "type": "integer"
          },
          "repo": {
            "title": "Repo",
            "type": "string"
          },
          "result": {
            "$ref": "#/components/schemas/GateResult",
            "description": "Exit 0 only when state is `final` and result is `pass`. A pass has a basis: `decision` (a stored ALLOW with an executed authorization), `baseline` or `break_glass` (each an audited row). A recorded pass reads `fail gate_expired` 15 minutes after `answered_at` or at `wait_until`."
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "state": {
            "$ref": "#/components/schemas/GateState",
            "description": "Exit 0 only when state is `final` and result is `pass`. A pass has a basis: `decision` (a stored ALLOW with an executed authorization), `baseline` or `break_glass` (each an audited row). A recorded pass reads `fail gate_expired` 15 minutes after `answered_at` or at `wait_until`."
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "verdict": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Verdict"
              },
              {
                "type": "null"
              }
            ]
          },
          "wait_until": {
            "format": "date-time",
            "title": "Wait Until",
            "type": "string"
          },
          "waiting_for": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WaitingFor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "schema_version",
          "kind",
          "gate_id",
          "tenant_id",
          "change_id",
          "correlation_id",
          "repo",
          "commit_sha",
          "environment",
          "policy_environment",
          "state",
          "result",
          "basis",
          "verdict",
          "waiting_for",
          "reasons",
          "reasons_total",
          "failure",
          "decision_id",
          "inputs_hash",
          "authorization_id",
          "console_url",
          "approve_url",
          "wait_until",
          "poll_after_seconds",
          "answered_at"
        ],
        "title": "ReleaseGateAnswer",
        "type": "object"
      },
      "ReleaseGateRequest": {
        "additionalProperties": false,
        "description": "`POST /v1/gate/checks`; the tenant comes only from the token, so the body can't name one.",
        "properties": {
          "break_glass_reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Break Glass Reason"
          },
          "commit_sha": {
            "pattern": "^[0-9a-f]{40}$",
            "title": "Commit Sha",
            "type": "string"
          },
          "environment": {
            "pattern": "^[a-z][a-z0-9-]{0,62}$",
            "title": "Environment",
            "type": "string"
          },
          "pipeline": {
            "$ref": "#/components/schemas/GatePipeline"
          },
          "pull_request": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Pull Request"
          },
          "ref": {
            "anyOf": [
              {
                "maxLength": 255,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ref"
          },
          "repo": {
            "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$",
            "title": "Repo",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "schema_version",
          "repo",
          "commit_sha",
          "environment",
          "pipeline"
        ],
        "title": "ReleaseGateRequest",
        "type": "object"
      },
      "RemedyAction": {
        "enum": [
          "fix_and_push",
          "add_agent_mapping_in_zof_yaml",
          "grant_agent_in_catalogue",
          "human_takes_over",
          "run_capability",
          "turn_on_code_review",
          "request_review",
          "wait",
          "add_unit_tests",
          "add_criteria_or_waive",
          "retry_when_available",
          "rerun_with_current_policy",
          "map_files_in_zof_yaml",
          "obtain_approval",
          "publish_release_policy"
        ],
        "title": "RemedyAction",
        "type": "string"
      },
      "Verdict": {
        "enum": [
          "allow",
          "deny",
          "require_evidence",
          "require_approval",
          "limit",
          "canary",
          "rollback",
          "remediate"
        ],
        "title": "Verdict",
        "type": "string"
      },
      "WaitingFor": {
        "enum": [
          "decision",
          "evidence",
          "approval"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "pipelineToken": {
        "description": "A `zgt_` pipeline token with scope `gate:decide`.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "gate.v1 (EVENT_SAMPLES v3.110). Tenant, company and account come only from the pipeline token.",
    "title": "Zof Control Plane CI/CD release gate",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/gate/checks": {
      "post": {
        "description": "`zof gate decide --environment <name>` exits: 0 pass, 1 blocked, 2 usage or configuration, 3 Zof unavailable, 4 token. A 404 while polling a gate_id the CLI just created is 3. Exit 0 only when state is `final` and result is `pass`. A pass has a basis: `decision` (a stored ALLOW with an executed authorization), `baseline` or `break_glass` (each an audited row). A recorded pass reads `fail gate_expired` 15 minutes after `answered_at` or at `wait_until`.",
        "operationId": "create_gate_check",
        "parameters": [
          {
            "description": "`<provider>:<run_id>:<run_attempt>:<job>:<environment>`; the same key and body return the same call.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "pattern": "^[\\x21-\\x7e]{1,200}$",
              "type": "string"
            }
          },
          {
            "description": "Minted if absent.",
            "in": "header",
            "name": "X-Correlation-ID",
            "required": false,
            "schema": {
              "pattern": "^[A-Za-z0-9._:-]{1,128}$",
              "type": "string"
            }
          },
          {
            "description": "Break-glass token; sent exactly with `break_glass_reason`.",
            "in": "header",
            "name": "X-Zof-Break-Glass",
            "required": false,
            "schema": {
              "pattern": "^zbg_[A-Za-z0-9_-]{43}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReleaseGateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseGateAnswer"
                }
              }
            },
            "description": "An existing call's current answer (a replay)."
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseGateAnswer"
                }
              }
            },
            "description": "A new call, answered final."
          },
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseGateAnswer"
                }
              }
            },
            "description": "A new or existing call, still waiting; poll the GET."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`token_expired`, `unauthorized`; CLI exit 4."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`break_glass_not_allowed`, `company_unbound`, `environment_not_allowed`, `gate_not_enabled`, `insufficient_scope`; CLI exit 4."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`not_found`, `repo_not_found`; CLI exit 2."
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`commit_ambiguous`, `commit_unknown`, `idempotency_conflict`; CLI exit 1, 2."
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`payload_too_large`; CLI exit 2."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`idempotency_key_required`, `invalid_body`, `unknown_environment`; CLI exit 2."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`rate_limited`; CLI exit 3.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`policy_lagging`, `unavailable`, `verification_unavailable`; CLI exit 3.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Ask whether this commit may deploy to this environment"
      }
    },
    "/v1/gate/checks/{gate_id}": {
      "get": {
        "description": "`zof gate decide --environment <name>` exits: 0 pass, 1 blocked, 2 usage or configuration, 3 Zof unavailable, 4 token. A 404 while polling a gate_id the CLI just created is 3. Exit 0 only when state is `final` and result is `pass`. A pass has a basis: `decision` (a stored ALLOW with an executed authorization), `baseline` or `break_glass` (each an audited row). A recorded pass reads `fail gate_expired` 15 minutes after `answered_at` or at `wait_until`.",
        "operationId": "read_gate_check",
        "parameters": [
          {
            "in": "path",
            "name": "gate_id",
            "required": true,
            "schema": {
              "pattern": "^gate_[0-9a-f]{32}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "wait",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReleaseGateAnswer"
                }
              }
            },
            "description": "The call's current answer."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`token_expired`, `unauthorized`; CLI exit 4."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`break_glass_not_allowed`, `company_unbound`, `environment_not_allowed`, `gate_not_enabled`, `insufficient_scope`; CLI exit 4."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`not_found`, `repo_not_found`; CLI exit 2."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`idempotency_key_required`, `invalid_body`, `unknown_environment`; CLI exit 2."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`rate_limited`; CLI exit 3.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GateError"
                }
              }
            },
            "description": "`policy_lagging`, `unavailable`, `verification_unavailable`; CLI exit 3.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "summary": "Read a gate call's answer, waiting up to `wait` seconds for it to change"
      }
    }
  },
  "security": [
    {
      "pipelineToken": []
    }
  ]
}
